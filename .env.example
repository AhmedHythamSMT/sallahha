# --- Sallahha FieldOps env (copy to .env, never commit .env) ---
# All optional in MVP: app boots in MOCK mode when empty.

# Optional remote (Supabase) — Phase 5. Leave empty for local mock demo.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Env switch: mock | supabase (default mock)
DATA_SOURCE=mock

# Optional Firebase (FCM/analytics/crash adapters, default OFF)
USE_FIREBASE=false

# Optional map tiles (default OSM public + mock fallback; respect tile policy)
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
